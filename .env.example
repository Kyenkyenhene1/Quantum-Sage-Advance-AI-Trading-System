# Copy this file to .env.local and fill in your values
```dotenv
# Copy this file to .env.local and fill in your values. Do NOT commit secrets.
# GENERAL
NODE_ENV=development

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Credentials must be configured locally; do not commit real values.
DEV_AUTH_USERNAME=
DEV_AUTH_PASSWORD=

# Live order execution (server-side only; never expose keys in browser code)
SERVER_SIDE_API_KEY=
TRADING_ACCOUNT_ID=
ORDER_EXECUTOR_URL=
ORDER_EXECUTOR_API_KEY=

# AI / Metrics
AI_METRICS_API_KEY=replace-with-a-secure-key
AI_MODEL_VERSION=1.0.0
AI_GLOBAL_RATE_LIMIT=200

# Redis (optional - enable in production/staging for distributed cache/rate-limit)
REDIS_URL=

# Audit (optional)
# When set, the app will use PostgreSQL for audit logs. Example:
# AUDIT_PG_URL=postgres://user:pass@db:5432/quantumsage
# Or use the SQLite file-backed audit DB path:
# AUDIT_DB_PATH=logs/audit.db
# Or specify a file path for JSONL audit fallback:
# AUDIT_LOG_PATH=logs/executions.log

# Metrics endpoint protection (optional):
# METRICS_API_KEY=replace-with-secure-key

# Tracing (optional): configure OTLP/collector endpoint if you want to export traces
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=quantumsage-app

``` 
